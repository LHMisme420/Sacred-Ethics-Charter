@dataclass
class DAOProposal:
    """Enhanced DAO proposal with economic incentives"""
    proposal_id: str
    proposer: str
    title: str
    description: str
    proposal_type: str
    stake_amount: float
    execution_code: Optional[str] = None
    funding_request: float = 0.0
    milestone_hashes: List[str] = field(default_factory=list)
    votes_for: float = 0.0
    votes_against: float = 0.0
    votes_abstain: float = 0.0
    status: str = "pending"
    created_at: datetime = field(default_factory=datetime.utcnow)
    voting_ends: datetime = field(default_factory=lambda: datetime.utcnow() + timedelta(days=3))

class DAOGovernance:
    """
    Decentralized Autonomous Organization governance system
    Implements on-chain governance with economic incentives
    """
    
    def __init__(self, config: ConfigManager):
        self.config = config.config["dao"]
        self.proposals: Dict[str, DAOProposal] = {}
        self.treasury_balance = 10000.0  # Initial treasury
        self.staked_tokens: Dict[str, float] = {}
        
    async def submit_proposal(self, 
                             proposer: str,
                             title: str,
                             description: str,
                             proposal_type: str,
                             stake_amount: float,
                             execution_code: Optional[str] = None,
                             funding_request: float = 0.0) -> DAOProposal:
        """Submit a DAO proposal with stake"""
        
        if stake_amount < self.config["proposal_stake"]:
            raise ValueError(f"Minimum stake required: {self.config['proposal_stake']}")
        
        if funding_request > self.treasury_balance * 0.1:
            raise ValueError("Funding request exceeds 10% of treasury")
        
        proposal_id = hashlib.sha256(
            f"{proposer}{title}{datetime.utcnow().isoformat()}".encode()
        ).hexdigest()[:16]
        
        proposal = DAOProposal(
            proposal_id=proposal_id,
            proposer=proposer,
            title=title,
            description=description,
            proposal_type=proposal_type,
            stake_amount=stake_amount,
            execution_code=execution_code,
            funding_request=funding_request
        )
        
        # Lock stake
        if proposer not in self.staked_tokens:
            self.staked_tokens[proposer] = 0
        self.staked_tokens[proposer] += stake_amount
        
        self.proposals[proposal_id] = proposal
        
        logger.info(f"DAO Proposal {proposal_id} submitted with {stake_amount} stake")
        return proposal
    
    async def vote(self, proposal_id: str, voter: str, 
                  vote: str, weight: float) -> Dict:
        """Cast a vote on a DAO proposal"""
        
        if proposal_id not in self.proposals:
            raise ValueError("Proposal not found")
        
        proposal = self.proposals[proposal_id]
        
        if datetime.utcnow() > proposal.voting_ends:
            raise ValueError("Voting period ended")
        
        if vote == "for":
            proposal.votes_for += weight
        elif vote == "against":
            proposal.votes_against += weight
        else:
            proposal.votes_abstain += weight
        
        # Check if proposal passes
        total_votes = proposal.votes_for + proposal.votes_against
        if total_votes > 0:
            approval_rate = proposal.votes_for / total_votes
            
            if approval_rate >= self.config.parent.config["system"]["consensus_threshold"]:
                proposal.status = "approved"
                await self._execute_proposal(proposal)
            elif datetime.utcnow() >= proposal.voting_ends:
                proposal.status = "rejected"
                # Return stake for rejected proposals (minus penalty)
                self.staked_tokens[proposal.proposer] -= proposal.stake_amount * 0.1
        
        return {
            "proposal_id": proposal_id,
            "current_votes": {
                "for": proposal.votes_for,
                "against": proposal.votes_against,
                "abstain": proposal.votes_abstain
            },
            "status": proposal.status
        }
    
    async def _execute_proposal(self, proposal: DAOProposal):
        """Execute an approved proposal"""
        
        if proposal.funding_request > 0:
            self.treasury_balance -= proposal.funding_request
            logger.info(f"Released {proposal.funding_request} from treasury")
        
        if proposal.execution_code:
            # In production, this would execute smart contract code
            logger.info(f"Executing proposal code: {proposal.execution_code[:50]}...")
        
        # Return stake plus reward
        self.staked_tokens[proposal.proposer] -= proposal.stake_amount
        reward = proposal.stake_amount * 0.1
        
        logger.info(f"Proposal {proposal.proposal_id} executed successfully")

