            base_score += 0.05
        
        return min(base_score, 1.0)
    
    async def get_system_dashboard(self) -> Dict:
        """Get comprehensive system dashboard"""
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # Get project statistics
        cursor.execute("SELECT COUNT(*), AVG(compliance_score) FROM projects")
        project_count, avg_compliance = cursor.fetchone()
        
        # Get node statistics  
        cursor.execute("SELECT COUNT(*), AVG(reputation_score) FROM nodes")
        node_count, avg_reputation = cursor.fetchone()
        
        # Get governance statistics
        cursor.execute("SELECT COUNT(*), COUNT(CASE WHEN outcome = 'approved' THEN 1 END) FROM governance_decisions")
        total_decisions, approved_decisions = cursor.fetchone()
        
        conn.close()
        
        dashboard = {
            "system": {
                "version": self.config.config["system"]["version"],
                "network": self.config.config["system"]["network_id"],
                "uptime": "100%",  # Simulated
                "health": "operational"
            },
            "projects": {
                "total": project_count or 0,
                "average_compliance": avg_compliance or 0,
                "active": 0  # Would track active projects
            },
            "governance": {
                "dao_treasury": self.dao.treasury_balance,
                "total_decisions": total_decisions or 0,
                "approved_decisions": approved_decisions or 0,
                "active_proposals": len([p for p in self.dao.proposals.values() 
                                        if p.status == "pending"])
            },
            "network": {
                "total_nodes": node_count or 0,
                "average_reputation": avg_reputation or 1.0,
                "fl_rounds": self.fl_engine.round_number
            },
            "metrics": self.metrics
        }
        
        return dashboard

