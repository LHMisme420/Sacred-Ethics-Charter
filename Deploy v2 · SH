        <div class="subtitle">Production Governance System</div>
        <div class="status">OPERATIONAL</div>
    </div>
    
    <div class="metrics">
        <div class="metric-card">
            <div class="metric-title">Network Status</div>
            <div class="metric-value">ACTIVE</div>
            <div class="metric-label">helix_mainnet</div>
        </div>
        
        <div class="metric-card">
            <div class="metric-title">Active Nodes</div>
            <div class="metric-value" id="node-count">5</div>
