        </div>
        
        <div class="metric-card">
            <div class="metric-title">ZK Proofs Generated</div>
            <div class="metric-value" id="proof-count">0</div>
            <div class="metric-label">Cryptographic Attestations</div>
        </div>
        
        <div class="metric-card">
            <div class="metric-title">DAO Treasury</div>
            <div class="metric-value" id="treasury">10,000</div>
            <div class="metric-label">Tokens Available</div>
        </div>
        
        <div class="metric-card">
            <div class="metric-title">Average Compliance</div>
            <div class="metric-value" id="compliance">0%</div>
            <div class="metric-label">Across All Projects</div>
        </div>
    </div>
    
    <div class="pillars">
        <h2>The Three Sacred Pillars</h2>
        <div class="pillar">
            <strong>Pillar 1: Absolute Truth and Integrity</strong>
            <div>Every creation must possess intrinsic alignment with reality</div>
        </div>
        <div class="pillar">
            <strong>Pillar 2: Sustainable Utility</strong>
            <div>Creations must be net positive in their contribution</div>
        </div>
