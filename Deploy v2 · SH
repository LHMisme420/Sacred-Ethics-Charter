    <div class="footer">
        <p>"The power to create is a sacred responsibility"</p>
        <p style="margin-top: 10px; font-size: 0.9em;">Sacred Ethics Charter v2.0 | Deployment ID: ${DEPLOYMENT_ID}</p>
    </div>
    
    <script>
        // Auto-update metrics (in production, would fetch from API)
        setInterval(() => {
            const proposals = document.getElementById('proposal-count');
            const current = parseInt(proposals.innerText);
            if (Math.random() > 0.7) {
                proposals.innerText = current + 1;
            }
        }, 5000);
    </script>
</body>
</html>
EOF

echo "   ✓ Dashboard created"

# Create systemd service (for non-Docker deployment)
echo ""
echo "⚙️  Creating systemd service..."

cat > sacred-ethics.service << EOF
[Unit]
Description=Sacred Ethics Charter v2.0
After=network.target

[Service]
Type=simple
User=sacred
WorkingDirectory=/opt/sacred-ethics
ExecStart=/opt/sacred-ethics/venv/bin/python sacred_ethics_v2.py --dashboard
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

echo "   ✓ Systemd service created"

# Create deployment summary
echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║              DEPLOYMENT PREPARED                          ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""
echo "📂 Deployment Directory: $DEPLOY_DIR"
echo "📋 Configuration: config.yaml"
echo "🐳 Docker: docker-compose.yml"
echo "📊 Dashboard: http://localhost:3000"
echo "📈 Metrics: http://localhost:9091"
echo "📉 Grafana: http://localhost:3001"
echo ""
echo "To deploy:"
echo ""
echo "  1. Docker deployment:"
echo "     docker-compose up -d"
echo ""
echo "  2. Direct Python deployment:"
echo "     source venv/bin/activate"
echo "     python sacred_ethics_v2.py --deploy"
echo ""
echo "  3. Systemd service (Linux):"
echo "     sudo cp sacred-ethics.service /etc/systemd/system/"
echo "     sudo systemctl enable sacred-ethics"
echo "     sudo systemctl start sacred-ethics"
echo ""
echo "✓ Deployment package ready for Sacred Ethics Charter v2.0"
echo "  'Every creation impacts the reality it enters'"
echo ""
