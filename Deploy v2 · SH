            border: 1px solid rgba(0,255,0,0.5);
            margin-top: 10px;
        }
        .pillars {
            margin-top: 40px;
            padding: 20px;
            background: rgba(255,255,255,0.05);
            border-radius: 15px;
        }
        .pillar {
            margin: 15px 0;
            padding: 15px;
