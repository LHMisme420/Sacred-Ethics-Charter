class LineageRecord:
    """
    Maintains immutable record of all creation artifacts and their provenance
    Implements tamper-proof audit trail for Pillar 1.B: Duty of Revelation
    """
    
    def __init__(self, archive_path: str = "lineage_archive"):
        self.archive_path = Path(archive_path)
        self.archive_path.mkdir(exist_ok=True)
        self.manifest_path = self.archive_path / "manifest.json"
        self._load_manifest()
    
    def _load_manifest(self):
        """Load or create the master manifest"""
        if self.manifest_path.exists():
            with open(self.manifest_path, 'r') as f:
                self.manifest = json.load(f)
        else:
            self.manifest = {
                "created": datetime.utcnow().isoformat(),
                "charter_version": "1.0.0",
                "records": []
            }
            self._save_manifest()
    
    def _save_manifest(self):
        """Save the manifest with atomic write"""
        temp_path = self.manifest_path.with_suffix('.tmp')
        with open(temp_path, 'w') as f:
            json.dump(self.manifest, f, indent=2)
        temp_path.replace(self.manifest_path)
    
    def create_artifact_record(self, 
                              artifact_type: str,
                              artifact_data: Dict,
                              creator_id: str,
                              compliance_report: Optional[Dict] = None) -> str:
        """Create an immutable record of an artifact"""
        
        record_id = hashlib.sha256(
            f"{artifact_type}{creator_id}{datetime.utcnow().isoformat()}".encode()
        ).hexdigest()[:16]
        
        record = {
            "record_id": record_id,
            "artifact_type": artifact_type,
            "creator_id": creator_id,
            "timestamp": datetime.utcnow().isoformat(),
            "artifact_hash": hashlib.sha256(
                json.dumps(artifact_data, sort_keys=True).encode()
            ).hexdigest(),
            "compliance_attestation": compliance_report.get("attestation_hash") if compliance_report else None,
            "artifact_data": artifact_data,
            "lineage": {
                "parent_records": [],
                "charter_version": "1.0.0",
                "generation": 1
            }
        }
        
        # Calculate record hash
        record_hash = hashlib.sha256(
            json.dumps(record, sort_keys=True).encode()
        ).hexdigest()
        record["record_hash"] = record_hash
        
        # Save individual record
        record_path = self.archive_path / f"{record_id}.json"
        with open(record_path, 'w') as f:
            json.dump(record, f, indent=2)
        
        # Update manifest
        self.manifest["records"].append({
            "record_id": record_id,
            "artifact_type": artifact_type,
            "creator_id": creator_id,
            "timestamp": record["timestamp"],
            "record_hash": record_hash,
            "file_path": str(record_path)
        })
        self._save_manifest()
        
        return record_id
    
    def verify_record(self, record_id: str) -> Tuple[bool, str]:
        """Verify integrity of a record"""
        
        record_path = self.archive_path / f"{record_id}.json"
        if not record_path.exists():
            return False, "Record not found"
        
        with open(record_path, 'r') as f:
            record = json.load(f)
        
        # Recalculate hash
        stored_hash = record.pop("record_hash", None)
        calculated_hash = hashlib.sha256(
            json.dumps(record, sort_keys=True).encode()
        ).hexdigest()
        
        if stored_hash == calculated_hash:
            return True, "Record intact and verified"
        else:
            return False, "Record tampered - hash mismatch"
    
    def get_lineage_tree(self, record_id: str) -> Dict:
        """Get the complete lineage tree for a record"""
        
        record_path = self.archive_path / f"{record_id}.json"
        if not record_path.exists():
            return {}
        
        with open(record_path, 'r') as f:
            record = json.load(f)
        
        lineage_tree = {
            "record_id": record_id,
            "artifact_type": record.get("artifact_type"),
            "generation": record["lineage"]["generation"],
            "parents": []
        }
        
        # Recursively get parent records
        for parent_id in record["lineage"]["parent_records"]:
            parent_tree = self.get_lineage_tree(parent_id)
            if parent_tree:
                lineage_tree["parents"].append(parent_tree)
        
        return lineage_tree

