@dataclass
class ResourceUsage:
    """Track resource consumption and regeneration"""
    resource_type: str  # energy, compute, carbon, materials
    amount_consumed: float
    unit: str
    timestamp: datetime
    project_id: str
    offset_committed: float = 0.0
    offset_completed: float = 0.0

class ResourceRegenerationTracker:
    """
    Tracks resource consumption and ensures regenerative commitments are met
    Implements Pillar 2.C: The Favor of Regeneration
    """
    
    def __init__(self, db_path: str = "regeneration.db"):
        self.db_path = db_path
        self._init_database()
        
    def _init_database(self):
        """Initialize SQLite database for tracking"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS resource_usage (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                project_id TEXT NOT NULL,
                resource_type TEXT NOT NULL,
                amount_consumed REAL NOT NULL,
                unit TEXT NOT NULL,
                timestamp TEXT NOT NULL,
                offset_committed REAL DEFAULT 0,
                offset_completed REAL DEFAULT 0,
                carbon_equivalent REAL,
                attestation_hash TEXT
            )
        ''')
        
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS regeneration_events (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                project_id TEXT NOT NULL,
                action_type TEXT NOT NULL,
                amount REAL NOT NULL,
                verification_proof TEXT,
                timestamp TEXT NOT NULL,
                verified BOOLEAN DEFAULT FALSE
            )
        ''')
        
        conn.commit()
        conn.close()
    
    def log_consumption(self, project_id: str, resource_type: str, 
                       amount: float, unit: str) -> str:
        """Log resource consumption for a project"""
        
        # Calculate carbon equivalent
        carbon_factors = {
            "kwh": 0.5,  # kg CO2 per kWh
            "compute_hour": 0.2,  # kg CO2 per compute hour
            "gb_storage": 0.01,  # kg CO2 per GB stored per year
        }
        
        carbon_equivalent = amount * carbon_factors.get(unit.lower(), 0.1)
        
        # Generate attestation
        attestation_data = {
            "project_id": project_id,
            "resource_type": resource_type,
            "amount": amount,
            "unit": unit,
            "carbon_equivalent": carbon_equivalent,
            "timestamp": datetime.utcnow().isoformat()
        }
        attestation_hash = hashlib.sha256(
            json.dumps(attestation_data, sort_keys=True).encode()
        ).hexdigest()
        
        # Store in database
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            INSERT INTO resource_usage 
            (project_id, resource_type, amount_consumed, unit, timestamp, 
             carbon_equivalent, attestation_hash)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        ''', (project_id, resource_type, amount, unit, 
              datetime.utcnow().isoformat(), carbon_equivalent, attestation_hash))
        
        conn.commit()
        conn.close()
        
        return attestation_hash
    
    def commit_offset(self, project_id: str, offset_type: str, amount: float) -> Dict:
        """Commit to a regenerative offset action"""
        
        offset_values = {
            "tree_planting": 21,  # kg CO2 per tree per year
            "solar_panel": 400,  # kg CO2 offset per panel per year
            "carbon_credit": 1000,  # kg CO2 per credit
            "open_source_contribution": 50,  # social offset value
        }
        
        offset_value = amount * offset_values.get(offset_type, 10)
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            INSERT INTO regeneration_events 
            (project_id, action_type, amount, timestamp)
            VALUES (?, ?, ?, ?)
        ''', (project_id, offset_type, offset_value, datetime.utcnow().isoformat()))
        
        # Update project's offset commitment
        cursor.execute('''
            UPDATE resource_usage 
            SET offset_committed = offset_committed + ?
            WHERE project_id = ?
        ''', (offset_value, project_id))
        
        conn.commit()
        conn.close()
        
        return {
            "project_id": project_id,
            "offset_type": offset_type,
            "offset_value": offset_value,
            "status": "committed"
        }
    
    def verify_regeneration(self, project_id: str, verification_proof: str) -> bool:
        """Verify that regeneration commitments have been fulfilled"""
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # Get total consumption and commitments
        cursor.execute('''
            SELECT SUM(carbon_equivalent), SUM(offset_committed), SUM(offset_completed)
            FROM resource_usage
            WHERE project_id = ?
        ''', (project_id,))
        
        result = cursor.fetchone()
        if not result:
            return False
            
        total_consumed, total_committed, total_completed = result
        
        # Mark latest regeneration event as verified
        cursor.execute('''
            UPDATE regeneration_events
            SET verified = TRUE, verification_proof = ?
            WHERE project_id = ? AND verified = FALSE
        ''', (verification_proof, project_id))
        
        # Update completed offsets
        cursor.execute('''
            UPDATE resource_usage
            SET offset_completed = offset_committed
            WHERE project_id = ?
        ''', (project_id,))
        
        conn.commit()
        conn.close()
        
        # Check if project is carbon positive
        return total_committed >= total_consumed
    
    def get_regeneration_report(self, project_id: str) -> Dict:
        """Generate regeneration compliance report"""
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            SELECT SUM(carbon_equivalent), SUM(offset_committed), SUM(offset_completed)
            FROM resource_usage
            WHERE project_id = ?
        ''', (project_id,))
        
        result = cursor.fetchone()
        total_consumed, total_committed, total_completed = result or (0, 0, 0)
        
        cursor.execute('''
            SELECT action_type, SUM(amount), COUNT(*), SUM(verified)
            FROM regeneration_events
            WHERE project_id = ?
            GROUP BY action_type
        ''', (project_id,))
        
        regeneration_actions = cursor.fetchall()
        conn.close()
        
        return {
            "project_id": project_id,
            "total_carbon_consumed": total_consumed,
            "total_offset_committed": total_committed,
            "total_offset_completed": total_completed,
            "carbon_balance": total_committed - total_consumed,
            "is_carbon_positive": total_committed > total_consumed,
            "regeneration_actions": [
                {
                    "type": action[0],
                    "total_offset": action[1],
                    "count": action[2],
                    "verified_count": action[3]
                }
                for action in regeneration_actions
            ],
            "compliance_status": "compliant" if total_committed >= total_consumed else "non_compliant"
        }

